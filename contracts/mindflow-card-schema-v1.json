{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mindflow/card-schema-v1.json",
  "title": "Mindflow Card Schema v1",
  "description": "Knowledge card content protocol. Application-owned IDs, timestamps, content hashes and reading state are stored separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "hook",
    "summary",
    "topic_type",
    "tags",
    "key_takeaways",
    "branches",
    "faq",
    "caveats",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "hook": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "topic_type": {
      "enum": [
        "technical",
        "humanities",
        "historical",
        "practical",
        "exploratory",
        "mixed"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      }
    },
    "key_takeaways": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/branch"
      }
    },
    "faq": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer",
          "basis"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "basis": {
            "enum": [
              "conversation",
              "supplement",
              "needs_verification"
            ]
          }
        }
      }
    },
    "caveats": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chat_title",
        "chat_url"
      ],
      "properties": {
        "chat_title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "chat_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 2000
        }
      }
    }
  },
  "$defs": {
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "content",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Unique within one card, e.g. b1 or b1-1"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "description": "Plain text or restricted Markdown, never HTML or scripts"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/branch"
          }
        }
      }
    }
  }
}
